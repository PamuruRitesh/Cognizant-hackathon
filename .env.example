# Demo mode: when true, agents run OFFLINE (no network calls) and show as
# "AI unavailable". Set to false to run the two Grok agents live.
DEMO_MODE=false

# Where the API reads forecasts/recommendations from.
# Leave unset to auto-detect: data/processed if real artifacts exist, else mocks.
# STOCKPILOT_DATA_DIR=./data/processed

STOCKPILOT_API_BASE=http://localhost:8000/api

# xAI / Grok — powers both agents (Proposer + Verifier) and the assistant.
# Paste your key here.
XAI_API_KEY=
XAI_MODEL=grok-4-fast
# xAI retired older models (grok-3, grok-2) on 2025-05-15. Use a current id:
#   grok-4-fast (cheap/fast, good for chat) · grok-4.6 (flagship) · "latest"
# GROK_API_KEY is also accepted as an alias for XAI_API_KEY.

# Langfuse — LLM observability (traces every agent call). Optional: leave blank
# to disable. Get keys from your Langfuse project settings.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# US region: https://us.cloud.langfuse.com
