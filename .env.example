# Demo mode: deterministic, uses cached/template narratives, makes no network calls.
# Set to false only if you have an LLM key below and want live narratives.
DEMO_MODE=true

# Where the API reads forecasts/recommendations from.
# Leave unset to auto-detect: data/processed if real artifacts exist, else mocks.
# STOCKPILOT_DATA_DIR=./data/processed

STOCKPILOT_API_BASE=http://localhost:8000/api

# LLM for the explainer narratives. Only used when DEMO_MODE=false.
# src/agents/llm.py currently calls Grok via call_grok_api().
GROK_API_KEY=
